# Default configuration for the development server. These values control
# the base URLs the client uses to communicate with the backend services.
# When running via docker-compose these services are exposed on the host
# machine on the same ports as inside the containers. You can override
# these values at runtime by specifying environment variables on the
# docker-compose service definition.
VITE_USER_SERVICE_URL=http://localhost:3001
VITE_PRODUCT_SERVICE_URL=http://localhost:3002
VITE_ORDER_SERVICE_URL=http://localhost:3003